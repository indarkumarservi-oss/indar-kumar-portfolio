<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" fill="none">
  <rect width="1200" height="630" fill="#0a0f1a"/>
  <rect x="0" y="0" width="1200" height="630" fill="url(#grid)"/>
  <defs>
    <pattern id="grid" width="60" height="60" patternUnits="userSpaceOnUse">
      <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#1e2a3a" stroke-width="0.5"/>
    </pattern>
  </defs>
  <circle cx="600" cy="315" r="150" stroke="#06b6d4" stroke-width="3" fill="none" opacity="0.3"/>
